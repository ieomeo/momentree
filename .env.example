# 이 파일을 ".env.local"로 복사해서 사용하세요. (.env.local은 Git에 올라가지 않아요)
# 모먼트리 API 서버 주소. 끝에 /api를 붙이지 않아요.
#  - 내 컴퓨터에서 서버를 켰을 때: http://localhost:3000
#  - 배포 후: Render 서비스 주소 (예: https://momentree-api.onrender.com)
VITE_API_BASE_URL=http://localhost:3000

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
